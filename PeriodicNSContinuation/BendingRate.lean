import PeriodicNSContinuation.DirectionCriterion

/-!
# Bending rate of the vorticity direction: the hidden orthogonal property (October 2026)

Work in progress. **Nothing here proves `PeriodicBKMIntegrability` or Clay (B).**

## The coined October 2026 formulation
`PeriodicBendingRateHiddenProperty ν` is a **new formulation coined in October 2026** (credited as
new, dated Oct 31 2026; it was *not* recovered from earlier drafts). Precursors, credited as
geometric only: the author's May 17/21 2026 Drive notes (`Π_u` orthogonal to `u`; "invisible to
the dynamics generated by H") and the Aug 10 2026 notes *The Frohmanian Symplectic Tether*
(antisymmetric `B_anti` built from `û × (·)`, symmetric `B_sym = −κ∫…` with `Π_u` the pointwise
projection onto the plane perpendicular to the local velocity). Both state that their scope is
strictly geometric with no regularity claims; nothing analytic is attributed to them here. It makes precise the author's idea that plain
Navier–Stokes carries an "invisible, orthogonal" structure. In the May drafts that idea was the
tether form `𝔗_F` built with `Π_u`, the projection orthogonal to the velocity `u`; because that
form enters momentum only as a pressure gradient, the Leray projection removes it and it cannot
damp anything on its own (cf. `TetherKappaZero`). The October formulation moves the orthogonality
to the vorticity direction `t = ω/|ω|`: the *orthogonal strain* `(I − t⊗t) S t`, `S = sym ∇u`, is
exactly the part of the strain invisible to the stretching rate `t·St` (`inner_perpPart`), and it is
exactly what turns the vortex lines (`hasDerivAt_vortDir_lagrangian`).

## Proved here (0 sorry)
* `hasDerivAt_normalize` — finite-dimensional calculus: for `ω(s) ≠ 0`, `d/ds (ω/|ω|) =
  |ω|⁻¹ (I − t⊗t) ω'`.
* `hasDerivAt_vortDir_lagrangian` — the pointwise identity `Dt/Dt = (I − t⊗t) S t +
  ν |ω|⁻¹ (I − t⊗t) Δω` along any curve with `Dω/Dt = S ω + ν Δω` (`S` any linear map; for NS
  the antisymmetric part of `∇u` drops out of `(∇u)ω`, classical, not re-derived here).
* `inner_perpPart`, `strain_split` — the orthogonal strain is invisible to `t·St`.
* `abs_cfDepletion_le`, `cfDepletion_self`, `cfDepletion_le_of_holder` — the algebraic
  Constantin–Fefferman depletion: the geometric factor `(e·a) det(e,a,b)` of the Biot–Savart
  stretching kernel is bounded by `|b − a|`, hence by `K|y|^{1/2}` under `VortDirHolderHalf`.
* `gronwall_integrating_factor` — Grönwall with a time-dependent rate `g = G'` (the `g ∈ L¹`
  form of the classical argument), generalizing `exp_gronwall_Ioo`.
* `periodicDirectionEnstrophyGrowthL1_of_growth`, `periodicDirectionCriterion_of_growthL1` —
  the time-integrable growth hypothesis (weaker than the old constant-`A` one) plus Leray's
  criterion gives `PeriodicDirectionCriterion`.
* `periodicDirectionRegularity_of_bending`, `periodicBKMIntegrability_of_bending` — conditional
  links from the hidden property.

## Still OPEN (named `Prop`s)
* `PeriodicOrthogonalStrainControl ν` — every smooth plain NS solution has bounded orthogonal
  strain where `|ω|` is large (**the Clay core in this formulation; open**).
* `OrthogonalStrainToDirectionHolder ν` — that control yields `VortDirHolderHalf` (open; a
  time-derivative bound does not by itself give spatial Hölder regularity).
* `PeriodicDirectionEnstrophyGrowthL1 ν` — the analytic Constantin–Fefferman / Beirão da
  Veiga–Berselli step: Biot–Savart stretching representation on `T³` plus interpolation (open;
  only its algebraic depletion factor is proved here).
* `PeriodicH1BlowupCriterion ν` — Leray 1934 (open here).
-/

noncomputable section
open Set Filter Topology MeasureTheory InnerProductSpace FeffermanClayNS NavierStokes3D
open scoped RealInnerProductSpace

namespace PeriodicNSContinuation

open Corrected

section Algebra

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Coined. The component of `v` orthogonal to `t`: `(I − t⊗t) v`. -/
def perpPart (t v : E) : E := v - ⟪t, v⟫ • t

/-- **Proved.** The orthogonal part is invisible to the stretching rate. -/
theorem inner_perpPart {t : E} (ht : ‖t‖ = 1) (v : E) : ⟪t, perpPart t v⟫ = 0 := by
  simp [perpPart, inner_sub_right, inner_smul_right, ht]

/-- **Proved.** Derivative of the direction `ω/|ω|` along a curve with `ω ≠ 0`. -/
theorem hasDerivAt_normalize {ω : ℝ → E} {ω' : E} {s : ℝ} (hω : HasDerivAt ω ω' s)
    (h0 : ω s ≠ 0) :
    HasDerivAt (fun r => ‖ω r‖⁻¹ • ω r) (‖ω s‖⁻¹ • perpPart (‖ω s‖⁻¹ • ω s) ω') s := by
  have hn : 0 < ‖ω s‖ := norm_pos_iff.2 h0
  have hsq : HasDerivAt (fun r => ‖ω r‖ ^ 2) (2 * ⟪ω s, ω'⟫) s := hω.norm_sq
  have hsq0 : ‖ω s‖ ^ 2 ≠ 0 := by positivity
  have hnorm : HasDerivAt (fun r => ‖ω r‖) (2 * ⟪ω s, ω'⟫ / (2 * Real.sqrt (‖ω s‖ ^ 2))) s := by
    have := hsq.sqrt hsq0
    simpa [Real.sqrt_sq (norm_nonneg _)] using this
  have hinv := hnorm.inv hn.ne'
  have := hinv.smul hω
  convert this using 1
  simp only [perpPart, inner_smul_left, smul_sub, smul_smul,
    Real.sqrt_sq (norm_nonneg _), RCLike.conj_to_real]
  rw [sub_eq_add_neg, ← neg_smul]
  congr 2
  field_simp

theorem perpPart_add (t v w : E) : perpPart t (v + w) = perpPart t v + perpPart t w := by
  simp only [perpPart, inner_add_right, add_smul]; abel

theorem perpPart_smul (t v : E) (c : ℝ) : perpPart t (c • v) = c • perpPart t v := by
  simp only [perpPart, inner_smul_right, smul_sub, smul_smul, mul_comm]

/-- **Proved.** `S t` splits into its orthogonal (bending) part and its stretching part. -/
theorem strain_split (t v : E) : v = perpPart t v + ⟪t, v⟫ • t := by
  simp [perpPart]

/-- **Proved.** The pointwise Lagrangian identity for the vorticity direction: if
`Dω/Dt = S ω + ν L` (with `L = Δω` for NS) and `ω ≠ 0`, then
`Dt/Dt = (I − t⊗t) S t + ν |ω|⁻¹ (I − t⊗t) L`. -/
theorem hasDerivAt_vortDir_lagrangian {ω : ℝ → E} {S : E →L[ℝ] E} {L : E} {ν s : ℝ}
    (hω : HasDerivAt ω (S (ω s) + ν • L) s) (h0 : ω s ≠ 0) :
    HasDerivAt (fun r => ‖ω r‖⁻¹ • ω r)
      (perpPart (‖ω s‖⁻¹ • ω s) (S (‖ω s‖⁻¹ • ω s)) +
        (ν * ‖ω s‖⁻¹) • perpPart (‖ω s‖⁻¹ • ω s) L) s := by
  convert hasDerivAt_normalize hω h0 using 1
  rw [perpPart_add, perpPart_smul, map_smul, perpPart_smul, smul_add, smul_smul,
    mul_comm ν]

end Algebra


/-- Triple product `e · (a × b)`. -/
def det3 (e a b : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  e 0 * (a 1 * b 2 - a 2 * b 1) - e 1 * (a 0 * b 2 - a 2 * b 0) + e 2 * (a 0 * b 1 - a 1 * b 0)

lemma normsq3 (v : EuclideanSpace ℝ (Fin 3)) : ‖v‖ ^ 2 = v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 := by
  rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_three]
  simp [sq_abs]

theorem det3_sub (e a b : EuclideanSpace ℝ (Fin 3)) : det3 e a b = det3 e a (b - a) := by
  simp [det3]; ring

theorem det3_sq_le (e a c : EuclideanSpace ℝ (Fin 3)) :
    det3 e a c ^ 2 ≤ ‖e‖ ^ 2 * ‖a‖ ^ 2 * ‖c‖ ^ 2 := by
  rw [normsq3, normsq3, normsq3, det3]
  set w0 := a 1 * c 2 - a 2 * c 1
  set w1 := a 2 * c 0 - a 0 * c 2
  set w2 := a 0 * c 1 - a 1 * c 0
  have hL : (a 0 ^ 2 + a 1 ^ 2 + a 2 ^ 2) * (c 0 ^ 2 + c 1 ^ 2 + c 2 ^ 2) =
      w0 ^ 2 + w1 ^ 2 + w2 ^ 2 + (a 0 * c 0 + a 1 * c 1 + a 2 * c 2) ^ 2 := by
    simp only [w0, w1, w2]; ring
  have hCS : (e 0 * w0 + e 1 * w1 + e 2 * w2) ^ 2 ≤
      (e 0 ^ 2 + e 1 ^ 2 + e 2 ^ 2) * (w0 ^ 2 + w1 ^ 2 + w2 ^ 2) := by
    nlinarith [sq_nonneg (e 0 * w1 - e 1 * w0), sq_nonneg (e 0 * w2 - e 2 * w0),
      sq_nonneg (e 1 * w2 - e 2 * w1)]
  have he : e 0 * (a 1 * c 2 - a 2 * c 1) - e 1 * (a 0 * c 2 - a 2 * c 0) +
      e 2 * (a 0 * c 1 - a 1 * c 0) = e 0 * w0 + e 1 * w1 + e 2 * w2 := by
    simp only [w0, w1, w2]; ring
  rw [he, mul_assoc, hL]
  nlinarith [mul_nonneg (by positivity : (0:ℝ) ≤ e 0 ^ 2 + e 1 ^ 2 + e 2 ^ 2)
    (sq_nonneg (a 0 * c 0 + a 1 * c 1 + a 2 * c 2))]

theorem abs_det3_le (e a c : EuclideanSpace ℝ (Fin 3)) :
    |det3 e a c| ≤ ‖e‖ * ‖a‖ * ‖c‖ := by
  apply abs_le_of_sq_le_sq _ (by positivity)
  · simpa [mul_pow] using det3_sq_le e a c

/-- Coined. The geometric factor of the Constantin–Fefferman stretching kernel:
`(ŷ·ξ(x)) det(ŷ, ξ(x), ξ(x+y))`. -/
def cfDepletion (e a b : EuclideanSpace ℝ (Fin 3)) : ℝ := inner ℝ e a * det3 e a b

/-- **Proved.** Algebraic Constantin–Fefferman depletion: for unit `e`, `a`, the kernel factor is
at most `|b − a|` (so it vanishes when the directions agree). -/
theorem abs_cfDepletion_le {e a b : EuclideanSpace ℝ (Fin 3)} (he : ‖e‖ = 1) (ha : ‖a‖ = 1) :
    |cfDepletion e a b| ≤ ‖b - a‖ := by
  rw [cfDepletion, abs_mul, det3_sub]
  have h1 : |inner ℝ e a| ≤ 1 := by
    have := abs_real_inner_le_norm e a; rw [he, ha] at this; simpa using this
  have h2 := abs_det3_le e a (b - a)
  rw [he, ha, one_mul, one_mul] at h2
  calc |inner ℝ e a| * |det3 e a (b - a)| ≤ 1 * ‖b - a‖ :=
        mul_le_mul h1 h2 (abs_nonneg _) zero_le_one
    _ = ‖b - a‖ := one_mul _

theorem cfDepletion_self (e a : EuclideanSpace ℝ (Fin 3)) : cfDepletion e a a = 0 := by
  unfold cfDepletion det3; ring

/-- **Proved.** Grönwall with time-dependent rate `g = G'` (the `g ∈ L¹` form). -/
theorem gronwall_integrating_factor {f f' g G : ℝ → ℝ} {T' : ℝ} (hf : ContinuousOn f (Icc 0 T'))
    (hG : ContinuousOn G (Icc 0 T'))
    (hd : ∀ x ∈ Ioo 0 T', HasDerivAt f (f' x) x) (hGd : ∀ x ∈ Ioo 0 T', HasDerivAt G (g x) x)
    (hle : ∀ x ∈ Ioo 0 T', f' x ≤ g x * f x) :
    ∀ x ∈ Icc 0 T', f x ≤ f 0 * Real.exp (G x - G 0) := by
  set h : ℝ → ℝ := fun x => Real.exp (-G x) * f x with hh
  have hhc : ContinuousOn h (Icc 0 T') :=
    (Real.continuous_exp.comp_continuousOn hG.neg).mul hf
  have hhd : ∀ x ∈ Ioo 0 T', HasDerivAt h
      (Real.exp (-G x) * (-g x) * f x + Real.exp (-G x) * f' x) x := by
    intro x hx
    exact ((hGd x hx).neg.exp).mul (hd x hx)
  have hanti : AntitoneOn h (Icc 0 T') := by
    apply antitoneOn_of_deriv_nonpos (convex_Icc 0 T') hhc
    · intro x hx
      rw [interior_Icc] at hx
      exact (hhd x hx).differentiableAt.differentiableWithinAt
    · intro x hx
      rw [interior_Icc] at hx
      rw [(hhd x hx).deriv]
      have he := Real.exp_pos (-G x)
      have := hle x hx
      nlinarith
  intro x hx
  have h0 : (0:ℝ) ∈ Icc 0 T' := ⟨le_rfl, hx.1.trans hx.2⟩
  have := hanti h0 hx hx.1
  simp only [hh] at this
  have hmul := mul_le_mul_of_nonneg_left this (Real.exp_pos (G x)).le
  rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul] at hmul
  calc f x ≤ Real.exp (G x) * (Real.exp (-G 0) * f 0) := hmul
    _ = f 0 * Real.exp (G x - G 0) := by
      rw [sub_eq_add_neg, Real.exp_add]; ring

/-- **Proved.** Under `VortDirHolderHalf`, the depletion factor at two high-vorticity points is
`≤ K |x − y|^{1/2}`. -/
theorem cfDepletion_le_of_holder {u : TimeDependentVelocity} {T : ℝ} (h : VortDirHolderHalf u T) :
    ∃ Ω K : ℝ, 0 < Ω ∧ ∀ t ∈ Ico (0:ℝ) T, ∀ x y : T3, ∀ e : EuclideanSpace ℝ (Fin 3), ‖e‖ = 1 →
      Ω ≤ ‖vorticity (u t) x‖ → Ω ≤ ‖vorticity (u t) y‖ →
        |cfDepletion e (‖vorticity (u t) x‖⁻¹ • vorticity (u t) x)
            (‖vorticity (u t) y‖⁻¹ • vorticity (u t) y)| ≤ K * Real.sqrt ‖x - y‖ := by
  obtain ⟨Ω, K, hΩ, hK⟩ := h
  refine ⟨Ω, K, hΩ, fun t ht x y e he hx hy => ?_⟩
  have hxn : vorticity (u t) x ≠ 0 := fun h0 => by
    rw [h0, norm_zero] at hx; linarith
  have ha : ‖‖vorticity (u t) x‖⁻¹ • vorticity (u t) x‖ = 1 := by
    rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 hxn)]
  refine (abs_cfDepletion_le he ha).trans ?_
  rw [norm_sub_rev]
  exact hK t ht x y hx hy

/-! ## The PDE-level hidden property -/

/-- Coined. Unit vorticity direction `t = ω/|ω|` (zero where `ω = 0`). -/
def vortDir (v : VelocityField) (x : T3) : EuclideanSpace ℝ (Fin 3) :=
  ‖vorticity v x‖⁻¹ • vorticity v x

/-- Coined. Strain-rate tensor `S = ½(∇u + ∇uᵀ)` at `x`, as a linear map. -/
def strainAt (v : VelocityField) (x : T3) : T3 →L[ℝ] T3 :=
  (1/2 : ℝ) • (fderiv ℝ v x + ContinuousLinearMap.adjoint (fderiv ℝ v x))

/-- Coined (October 2026). The orthogonal strain `(I − t⊗t) S t`: the bending rate of the
vortex line, invisible to the stretching rate `t·St`. -/
def orthogonalStrain (v : VelocityField) (x : T3) : T3 :=
  perpPart (vortDir v x) (strainAt v x (vortDir v x))

/-- **Proved.** Where `ω ≠ 0`, the orthogonal strain is perpendicular to the vortex line. -/
theorem inner_vortDir_orthogonalStrain {v : VelocityField} {x : T3} (h : vorticity v x ≠ 0) :
    ⟪vortDir v x, orthogonalStrain v x⟫ = 0 := by
  apply inner_perpPart
  rw [vortDir, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ (norm_ne_zero_iff.2 h)]

/-- Coined (October 2026). On `[0,T)`, the orthogonal strain is bounded where `|ω| ≥ Λ`. -/
def OrthogonalStrainBounded (u : TimeDependentVelocity) (T : ℝ) : Prop :=
  ∃ Λ C : ℝ, 0 < Λ ∧ ∀ t ∈ Ico (0:ℝ) T, ∀ x : T3,
    Λ ≤ ‖vorticity (u t) x‖ → ‖orthogonalStrain (u t) x‖ ≤ C

/-- Coined (October 2026, new formulation). **OPEN — the Clay core in this formulation.** Every
smooth plain Navier–Stokes maximal solution on `T³` has bounded orthogonal strain where `|ω|` is
large, up to any finite lifespan. -/
def PeriodicOrthogonalStrainControl (ν : ℝ) : Prop :=
  0 < ν → ∀ u₀ : VelocityField, IsPeriodicSmoothInitialData u₀ →
    ∀ (u : TimeDependentVelocity) (p : TimeDependentPressure), IsPeriodicMaximalSolution ν u₀ u p →
      ∀ T : ℝ, periodicTstar ν u₀ = (T : EReal) → OrthogonalStrainBounded u T

/-- Coined (October 2026). **OPEN.** For maximal solutions, bounded orthogonal strain on the
high-vorticity region gives `½`-Hölder vorticity direction (`VortDirHolderHalf`). -/
def OrthogonalStrainToDirectionHolder (ν : ℝ) : Prop :=
  0 < ν → ∀ u₀ : VelocityField, IsPeriodicSmoothInitialData u₀ →
    ∀ (u : TimeDependentVelocity) (p : TimeDependentPressure), IsPeriodicMaximalSolution ν u₀ u p →
      ∀ T : ℝ, periodicTstar ν u₀ = (T : EReal) → OrthogonalStrainBounded u T →
        VortDirHolderHalf u T

/-- Coined (October 2026, new formulation; not recovered from the May drafts). **OPEN.** The hidden
orthogonal property of plain Navier–Stokes: orthogonal-strain control, strong enough to give
`VortDirHolderHalf`. Relates to the May `Π_u`-orthogonal tether `𝔗_F` idea (see module doc). -/
def PeriodicBendingRateHiddenProperty (ν : ℝ) : Prop :=
  PeriodicOrthogonalStrainControl ν ∧ OrthogonalStrainToDirectionHolder ν

/-- **Proved.** The hidden property implies `PeriodicDirectionRegularity`. -/
theorem periodicDirectionRegularity_of_bending {ν : ℝ} (h : PeriodicBendingRateHiddenProperty ν) :
    PeriodicDirectionRegularity ν :=
  fun hν u₀ hu₀ u p hm T hT => h.2 hν u₀ hu₀ u p hm T hT (h.1 hν u₀ hu₀ u p hm T hT)

/-- Coined. **Hypothesis (OPEN here; classical content: Constantin–Fefferman 1993 Biot–Savart
stretching representation and geometric depletion + Beirão da Veiga–Berselli 2002
interpolation).** Time-integrable form: the enstrophy rate is at most `g(t)·E` with `g = G'`,
`G` continuous on `[0,T]` (i.e. `g ∈ L¹`). Weaker than `PeriodicDirectionEnstrophyGrowth`. -/
def PeriodicDirectionEnstrophyGrowthL1 (ν : ℝ) : Prop :=
  0 < ν → ∀ u₀ : VelocityField, IsPeriodicSmoothInitialData u₀ →
    ∀ (u : TimeDependentVelocity) (p : TimeDependentPressure), IsPeriodicMaximalSolution ν u₀ u p →
      ∀ T : ℝ, periodicTstar ν u₀ = (T : EReal) → VortDirHolderHalf u T →
        ∃ g G : ℝ → ℝ, ContinuousOn G (Icc 0 T) ∧ (∀ t ∈ Ioo (0:ℝ) T, HasDerivAt G (g t) t) ∧
          ∀ t ∈ Ioo (0:ℝ) T,
            rateOf 1 (fourierNSField ν (fourierCoeffVF (u t))) (fourierCoeffVF (u t)) ≤
              g t * h1Sq (u t)

/-- **Proved.** The constant-rate hypothesis implies the time-integrable one. -/
theorem periodicDirectionEnstrophyGrowthL1_of_growth {ν : ℝ}
    (h : PeriodicDirectionEnstrophyGrowth ν) : PeriodicDirectionEnstrophyGrowthL1 ν := by
  intro hν u₀ hu₀ u p hm T hT hdir
  obtain ⟨A, hA⟩ := h hν u₀ hu₀ u p hm T hT hdir
  refine ⟨fun _ => A, fun t => A * t, (continuous_const.mul continuous_id).continuousOn,
    fun t _ => by simpa using (hasDerivAt_id t).const_mul A, hA⟩

/-- **Proved.** Time-integrable growth + Leray's criterion ⇒ `PeriodicDirectionCriterion`. -/
theorem periodicDirectionCriterion_of_growthL1 {ν : ℝ} (hG : PeriodicDirectionEnstrophyGrowthL1 ν)
    (hL : PeriodicH1BlowupCriterion ν) : PeriodicDirectionCriterion ν := by
  intro hν u₀ hu₀ u p hm T hT hdir
  obtain ⟨g, G, hGc, hGd, hA⟩ := hG hν u₀ hu₀ u p hm T hT hdir
  obtain ⟨B, hB⟩ := (isCompact_Icc (a := (0:ℝ)) (b := T)).exists_bound_of_continuousOn hGc
  apply hL hν u₀ hu₀ u p hm T hT
  refine ⟨h1Sq u₀ * Real.exp (2 * B), fun t ht => ?_⟩
  obtain ⟨hsol, htm, hle⟩ := sol_around hm hT ht
  obtain ⟨hc, hd⟩ := periodicEnstrophyIdentity ν hν u₀ u p _ hsol
  have hu0 : u 0 = u₀ := u_zero hsol
  have hsub : Icc (0:ℝ) ((t + T) / 2) ⊆ Icc 0 T := Icc_subset_Icc le_rfl hle
  have hsubo : ∀ x ∈ Ioo (0:ℝ) ((t + T) / 2), x ∈ Ioo (0:ℝ) T :=
    fun x hx => ⟨hx.1, lt_of_lt_of_le hx.2 hle⟩
  have key := gronwall_integrating_factor (f := fun t => h1Sq (u t)) (g := g) hc
    (hGc.mono hsub) (fun x hx => (hd x hx).2) (fun x hx => hGd x (hsubo x hx))
    (fun x hx => hA x (hsubo x hx)) t htm
  simp only [hu0] at key
  refine key.trans (mul_le_mul_of_nonneg_left ?_ (hsSq_nonneg 1 u₀))
  apply Real.exp_le_exp.2
  have h1 := hB t (hsub htm)
  have h2 := hB 0 (hsub ⟨le_rfl, htm.1.trans htm.2⟩)
  have := abs_le.1 h1; have := abs_le.1 h2
  linarith

/-- **Proved (conditional).** `PeriodicBKMIntegrability` from the time-integrable growth step,
Leray's criterion, and the OPEN hidden property. -/
theorem periodicBKMIntegrability_of_bending {ν : ℝ} (hG : PeriodicDirectionEnstrophyGrowthL1 ν)
    (hL : PeriodicH1BlowupCriterion ν) (hB : PeriodicBendingRateHiddenProperty ν) :
    PeriodicBKMIntegrability ν :=
  periodicBKMIntegrability_of_direction (periodicDirectionCriterion_of_growthL1 hG hL)
    (periodicDirectionRegularity_of_bending hB)

end PeriodicNSContinuation
